---
const pilares = [
  {
    title: 'Cierre de turno en PDF',
    description:
      'Al cerrar la caja, el reporte se genera al instante como PDF: listo para imprimir o enviar por mail. Tu resumen de ventas, claro y profesional, en un toque.',
    icon: 'pdf',
  },
  {
    title: 'Sin nube. Sin suscripcion.',
    description:
      'Toda tu informacion vive en tu propia maquina, en una base local. Sin internet, sin mensualidad y sin depender de nadie: el sistema funciona igual, con o sin conexion.',
    icon: 'offline',
  },
  {
    title: 'Tu marca, tu estilo',
    description:
      'Logo, tipografia y colores a tu medida. El sistema se ve como tu negocio, no como un producto generico. Esta misma pagina es la muestra: cambia los tokens de marca y se re-viste sola.',
    icon: 'palette',
  },
];
---

<section id="pilares" class="scroll-mt-24 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <header class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-ink-muted">
        Por que este sistema
      </p>
      <h2 class="mt-3 font-heading text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Tres razones para no volver atras
      </h2>
    </header>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        pilares.map((p) => (
          <article
            class="group rounded-2xl border border-edge bg-surface p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-line motion-reduce:transform-none"
          >
            <div class="grid h-12 w-12 place-items-center rounded-xl bg-brand-tint text-brand">
              {p.icon === 'pdf' && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                  aria-hidden="true"
                >
                  <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z" />
                  <path d="M14 2v5h5" />
                  <path d="M12 18v-6" />
                  <path d="m9 15 3 3 3-3" />
                </svg>
              )}
              {p.icon === 'offline' && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                  aria-hidden="true"
                >
                  <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
                  <path d="m3 3 18 18" />
                </svg>
              )}
              {p.icon === 'palette' && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-6 w-6"
                  aria-hidden="true"
                >
                  <path d="M12 21a9 9 0 1 1 9-9c0 1.66-1.34 3-3 3h-2.5a1.5 1.5 0 0 0-1.5 1.5c0 1.66-1.34 3-3 3H12z" />
                  <circle cx="7.5" cy="10.5" r="1" />
                  <circle cx="12" cy="7.5" r="1" />
                  <circle cx="16.5" cy="10.5" r="1" />
                </svg>
              )}
            </div>
            <h3 class="mt-6 font-heading text-xl font-semibold tracking-tight">
              {p.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-muted">{p.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
