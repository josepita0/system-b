---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Pilares from '../components/Pilares.astro';
import Capturas from '../components/Capturas.astro';
import Contacto from '../components/Contacto.astro';

const pageTitle = 'Zentra · POS Offline-First de Alto Rendimiento';
const pageDescription =
  'Sistema de punto de venta rápido y confiable que funciona 100% sin internet: cierre de turno con arqueo en PDF, catálogo visual, control de stock y métricas en tiempo real. Sin suscripciones, sin depender de la nube.';
---

<Layout title={pageTitle} description={pageDescription}>
  <Hero />
  <Pilares />
  <Capturas />
  <Contacto />
</Layout>
